# Environment Settings for TouchGrass AI Backend

# AI Provider selection: "mock" (for demo), "ollama" (for local AI), or "openai"
AI_PROVIDER=mock

# Model to use if using local Ollama (e.g., llama3, qwen, gemma)
MODEL_NAME=llama3

# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434

# Map and Routing providers
ROUTING_PROVIDER=osrm
MAP_PROVIDER=openstreetmap

# Database connection
DATABASE_URL=sqlite:///./touchgrass.db
