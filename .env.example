# ==============================================================================
# TouchGrass AI - Safe Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# PRIVACY & SECURITY GUARANTEE:
# - This template contains ZERO private keys, passwords, tokens, or credentials.
# - TouchGrass AI runs 100% locally and does NOT use or require any cloud API keys.
# - Do NOT place personal credentials, private tokens, or secrets in this file.
# ==============================================================================

# --- Open-Weight AI Engine ---
# AI provider: 'ollama' (local inference) or 'mock' (zero-dependency fallback)
AI_PROVIDER=ollama

# Open-weight model names (downloaded via Ollama)
MODEL_NAME=gemma2:2b
VISION_MODEL_NAME=moondream

# Local Ollama service endpoint (standard default port)
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenStreetMap Deterministic Routing ---
# Public routing engine and map tile providers
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
MAP_PROVIDER=openstreetmap

# --- Privacy & Application Modes ---
# Set to 'true' to load the instant Golden Gate Park demo walk
DEMO_MODE=false

# Strict local-only mode: keeps all location data, photos, and notes on device
LOCAL_ONLY=true

# --- Database & Local Storage ---
# Local SQLite database path (stored on your machine only)
DATABASE_URL=sqlite:///./touchgrass.db

# Allowed local development origins for CORS
CORS_ORIGINS=http://localhost:5173

