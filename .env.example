# ==============================================================================
# TouchGrass AI - Environment Configuration Template
# Copy this file to '.env' and adjust settings to match your local setup.
# None of these settings require external proprietary API keys.
# ==============================================================================

# --- AI Engine Settings ---
# Options: 'ollama' (local open-weight models) or 'mock' (zero-dependency fallback)
AI_PROVIDER=ollama
# Recommended text LLMs: 'gemma2:2b', 'llama3.2:1b', 'llama3.2:3b', 'qwen2.5:3b'
MODEL_NAME=gemma2:2b
# Recommended vision-language model: 'moondream' or 'llava:7b'
VISION_MODEL_NAME=moondream
# Local Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Deterministic Routing & Mapping ---
# Real-world routing engine (OSRM uses public OpenStreetMap geometry)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
MAP_PROVIDER=openstreetmap

# --- Application Modes ---
# Force demo adventure without requiring GPS or cellular signal
DEMO_MODE=false
# Strict local-only privacy mode: zero telemetry or cloud logging
LOCAL_ONLY=true

# --- Database & Server ---
DATABASE_URL=sqlite:///./touchgrass.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

